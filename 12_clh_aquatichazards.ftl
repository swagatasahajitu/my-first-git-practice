<h2 class="Heading2">CONCLUSION ON CLASSIFICATION AND LABELLING FOR AQUATIC HAZARDS</h2>
<#assign studyList = iuclid.getSectionDocumentsForParentKey(_subject.documentKey, "FLEXIBLE_RECORD", "Ghs") />
<p><#compress><#lt>

<b><u>Acute aquatic hazards:</u></b>
<#assign hazardField="AcuteShortTerm" />
<#assign fields=[
    "Classification.EnvironmentalHazards.AquaticEnvironment."+hazardField+".HazardCategory",
    "Classification.EnvironmentalHazards.AquaticEnvironment."+hazardField+".HazardStatement",
    "Classification.EnvironmentalHazards.AquaticEnvironment."+hazardField+".ReasonForNoClassification",
    "Classification.EnvironmentalHazards.AquaticEnvironment."+hazardField+".ReasonForClassification",
    "Classification.EnvironmentalHazards.AquaticEnvironment.MFactor.MFactorAcute",
    "Classification.EnvironmentalHazards.AquaticEnvironment.MFactor.MFactorChronic"
] />

<#list studyList as study>
    
        <p class="indent-narrow">
        <#compress><#lt>
            <#if study?has_content>                
                    <b><@com.text study.name/></b>
                        <#if study.GeneralInformation.RelatedCompositions.Composition?has_content>
                            <p><#compress><#lt><u>Related composition: <@com.documentReferenceMultiple study.GeneralInformation.RelatedCompositions.Composition/></u></#compress></p>
                        </#if>
                    <@com.printIf study fields[0] "Classification:&#160;" "" />
                    <@com.printIf study fields[1] "(" ")" />
                    <@com.printIf study fields[3] "," "" />
                    <@com.printIf study fields[2] "No classification is proposed. " "" />
                <#else>
                No relevant information available.<br/>
            </#if>  
        </#compress>
        </p>      
<#if study_has_next><p style="padding-top: 1.5px;"></p></#if>
</#list>

